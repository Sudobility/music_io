{
  "name": "@sudobility/music_io",
  "version": "0.6.3",
  "author": "Sudobility",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sudobility/music_lib": "^1.7.1",
    "@sudobility/music_types": "^0.11.1",
    "@tonejs/midi": "^2.0.28",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.38.0",
    "fast-xml-parser": "^5.10.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "tone": "^15.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@sudobility/music_lib": "^1.7.1",
    "@sudobility/music_types": "^0.11.1",
    "@tonejs/midi": "^2.0.28",
    "fast-xml-parser": "",
    "react-native-audio-api": ">=0.13.0",
    "react-native-fs": ">=2.20.0",
    "react-native-share": ">=10.0.0",
    "tone": "^15"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn/index.d.ts",
        "import": "./dist/rn/index.js"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js"
      }
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./rn": {
      "types": "./dist/rn/index.d.ts",
      "import": "./dist/rn/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    }
  },
  "description": "Platform implementations for ScoreSmith: playback, XML parsing, file export and MIDI codecs, for web and React Native",
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "scoresmith",
    "music",
    "platform",
    "react-native"
  ],
  "license": "BUSL-1.1",
  "peerDependenciesMeta": {
    "fast-xml-parser": {
      "optional": true
    },
    "react-native-audio-api": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    },
    "react-native-share": {
      "optional": true
    },
    "tone": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "type": "module",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  }
}
