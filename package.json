{
  "name": "@sudobility/music_io",
  "version": "0.9.78",
  "author": "Sudobility",
  "devDependencies": {
    "@breezystack/lamejs": "~1.2.7",
    "@eslint/js": "~10.0.1",
    "@sudobility/music_codecs": "^0.2.61",
    "@sudobility/music_types": "^0.13.59",
    "@types/node": "~22.20.5",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "fast-xml-parser": "~5.11.2",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "~4.1.12"
  },
  "peerDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@sudobility/music_codecs": "^0.2.61",
    "@sudobility/music_types": "^0.13.59",
    "fast-xml-parser": ">=5.0.0",
    "react-native-fs": ">=2.20.0",
    "react-native-share": ">=10.0.0"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn/index.d.ts",
        "import": "./dist/rn/index.js",
        "default": "./dist/rn/index.js"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js",
        "default": "./dist/web/index.js"
      }
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./rn": {
      "types": "./dist/rn/index.d.ts",
      "import": "./dist/rn/index.js",
      "default": "./dist/rn/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js",
      "default": "./dist/mocks/index.js"
    }
  },
  "description": "Platform implementations for ScoreSmith: audio codecs, XML parsing, file export and live MIDI input, for web and React Native",
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "scoresmith",
    "music",
    "platform",
    "react-native"
  ],
  "license": "BUSL-1.1",
  "peerDependenciesMeta": {
    "fast-xml-parser": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    },
    "react-native-share": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_io.git"
  }
}
